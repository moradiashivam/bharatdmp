{
  "fields": [
    {
      "field_name": "dataset_title",
      "field_label": "Dataset title",
      "field_type": "short_text",
      "group": "Data Description",
      "required": true,
      "placeholder": "e.g. Soil moisture readings 2025",
      "help_text": "A short, descriptive name for the dataset.",
      "max_length": 200,
      "domains": ["Agriculture"]
    },
    {
      "field_name": "data_volume_gb",
      "field_label": "Expected data volume (GB)",
      "field_type": "number",
      "group": "Data Description",
      "min_value": 0,
      "max_value": 100000
    },
    {
      "field_name": "data_sharing_level",
      "field_label": "How will the data be shared?",
      "field_type": "single_select",
      "group": "Sharing and Access",
      "required": true,
      "options": ["Open access", "Restricted access", { "label": "Not shared", "value": "closed" }]
    },
    {
      "field_name": "contains_personal_data",
      "field_label": "Does the data contain personal information?",
      "field_type": "yes_no",
      "group": "Ethics and Legal"
    }
  ]
}
