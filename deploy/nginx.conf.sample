# Sample nginx reverse proxy for the DMP system.
# Copy to /etc/nginx/sites-available/dmp, adjust the domain, enable, reload.

# Redirect all plain HTTP to HTTPS.
server {
    listen 80;
    server_name dmp.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name dmp.example.org;

    # certbot --nginx -d dmp.example.org  will fill these in for you
    ssl_certificate     /etc/letsencrypt/live/dmp.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dmp.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Uploads and generated PDFs
    client_max_body_size 25m;

    # Never let the browser execute anything served from the uploads folder.
    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 120s;
    }

    # Uptime monitoring
    location = /healthz {
        proxy_pass http://127.0.0.1:3000/healthz;
        access_log off;
    }
}
